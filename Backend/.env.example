# Copy to .env (never commit .env). The Unity build never sees these values.
PROVIDER=mock            # mock | anthropic | openai
HOST=127.0.0.1
PORT=8787

# Anthropic (PROVIDER=anthropic). Check https://docs.claude.com for current model names.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Any OpenAI-compatible endpoint (PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional shared token; put the same value in Assets/StreamingAssets/dialogue_config.json "clientToken".
# This identifies your build; it is NOT a secret once the game is shipped.
CLIENT_TOKEN=

# Cost / abuse limits
RATE_LIMIT_PER_MIN=20
MAX_REQUESTS_PER_DAY=500
PROVIDER_TIMEOUT_MS=6000
